# Application
APP_NAME=MarketMinds API
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Yahoo Finance
YFINANCE_TIMEOUT_SECONDS=15.0
HISTORY_PERIOD=1y
HISTORY_INTERVAL=1d

# Ticker validation
TICKER_MIN_LENGTH=1
