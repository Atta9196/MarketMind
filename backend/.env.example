# Local
APP_NAME=MarketMinds API
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production (Render) — set in the Render dashboard:
# CORS_ORIGINS=https://YOUR-APP.vercel.app,https://YOUR-APP-git-main-USER.vercel.app
# Include every Vercel URL that will call this API (production + preview if needed).

# Yahoo Finance
YFINANCE_TIMEOUT_SECONDS=15.0
HISTORY_PERIOD=1y
HISTORY_INTERVAL=1d

# Ticker validation
TICKER_MIN_LENGTH=1
TICKER_MAX_LENGTH=10

# Options pricing
OPTIONS_BINOMIAL_STEPS=100
OPTIONS_MONTE_CARLO_SIMULATIONS=10000
OPTIONS_MONTE_CARLO_SEED=42
# On Render free/starter, 2 workers is a safe default:
# OPTIONS_WORKER_PROCESSES=2
