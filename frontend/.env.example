# Local development (Vite proxies /api → localhost:8000)
VITE_API_URL=/api

# Production (Vercel) — set this in the Vercel project Environment Variables:
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
#
# Optional: longer timeout for Render cold starts (milliseconds)
# VITE_API_TIMEOUT_MS=120000
